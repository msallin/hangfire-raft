<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hangfire.Raft</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hangfire.Community.Raft</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marc Sallin</Authors>
    <Description>Hangfire job storage backed by a DotNext Raft cluster. State is replicated in-memory across nodes with a write-ahead log on disk; no external database required.</Description>
    <PackageTags>hangfire;storage;raft;cluster;dotnext</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/msallin/hangfire-raft</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msallin/hangfire-raft.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Marc Sallin</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="DotNext.Net.Cluster" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hangfire.Raft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
